# Baked into the built JS at `npm run build` time (Vite convention) — this
# file IS meant to be committed, unlike .env/.env.local. Update these once
# you know your cluster's .apps. domain, then rebuild
# (oc start-build mgo-backend) to pick up the change — editing this file
# alone does nothing until the image is rebuilt.
#
# These follow OpenShift's auto-generated Route hostname pattern:
#   <route-name>-<namespace>.apps.<cluster-domain>
# matching k8s/route.yaml's "mgo-backend" and "mgo-backend-ws" Routes.
VITE_API_URL=https://mgo-backend-7372268-test.apps.rtpfs-wpp2.wpp.nam.gm.com
VITE_WS_URL=wss://mgo-backend-7372268-test.apps.rtpfs-wpp2.wpp.nam.gm.com